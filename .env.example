# Copy to .env (ignored by Git). Fill secrets locally; never commit .env.
# Separate project names create isolated volumes. Use ragdesk-real for real models.
COMPOSE_PROJECT_NAME=ragdesk-fake
RAGDESK_MODE=fake
FRONTEND_PORT=8080
# Required: generate fresh values; there are no default database/JWT credentials.
POSTGRES_PASSWORD=
JWT_SECRET=
# Only real mode needs this key; fake mode clears it inside the app process.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini-2025-04-14
EMBEDDING_MODEL=text-embedding-3-small
