# Reference only. Set values as environment variables; this file is not loaded.
DATABASE_URL=postgresql+psycopg://ragdesk:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/ragdesk
# Step 12: one provider, with separate chat and embedding configuration.
CHAT_MODEL=gpt-4.1-mini-2025-04-14
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Retrieval defaults to openai; set fake explicitly only for an offline fake index.
# RETRIEVAL_EMBEDDING_BACKEND=fake
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_READ_TIMEOUT_SECONDS=30
MODEL_MAX_ATTEMPTS=3
# Optional private file location (default: backend/var/uploads); never serve statically.
# UPLOAD_STORAGE_DIR=C:\ragdesk-private\uploads
# JWT_SECRET must be a fresh random value of at least 32 bytes in the environment.
# JWT_SECRET=
# ACCESS_TOKEN_TTL_MINUTES=30
# OPENAI_API_KEY is required only when explicitly creating real model clients.
# Set it in the process environment, never in this file or Git.
